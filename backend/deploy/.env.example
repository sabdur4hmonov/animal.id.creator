# Copy to a private .env file. These are configuration placeholders, not credentials.
CHORVAM_DOMAIN=pilot.example.invalid
PUBLIC_ORIGIN=https://pilot.example.invalid
PILOT_STORAGE_ROOT=/srv/chorvam/storage
PILOT_SECRETS_ROOT=/srv/chorvam/secrets
PILOT_TLS_SNIPPET=./deploy/tls-public.caddy
PILOT_HTTP_BIND=0.0.0.0:80
PILOT_HTTPS_BIND=0.0.0.0:443
PILOT_NETWORK_SUBNET=172.30.42.0/24
PILOT_PROXY_IP=172.30.42.10
API_MEMORY_LIMIT=3g
DB_MEMORY_LIMIT=2g
PROXY_MEMORY_LIMIT=256m
